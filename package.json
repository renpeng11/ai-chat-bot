{
  "name": "feishu-ai-digest-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute feishu_ai_digest --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute feishu_ai_digest --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260430.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.14.1"
  }
}
